# Shared
MAIL_DOMAIN=test.local
MONGO_URI=mongodb://localhost:27017/tempmail-dev

# smtp-receiver
SMTP_PORT=2525
SMTP_MAX_MESSAGE_SIZE=10485760
SMTP_MAX_RECIPIENTS=5
SMTP_MAX_CONNECTIONS_PER_IP_PER_MIN=20
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

# api-server
API_PORT=3001
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
# Signs PIN-unlock session tokens. Generate a real value with: openssl rand -hex 32
MAILBOX_TOKEN_SECRET=
PIN_RATE_LIMIT_WINDOW_MS=600000
PIN_RATE_LIMIT_MAX=10

# web (build-time)
VITE_API_BASE_URL=/api
VITE_MAIL_DOMAIN=test.local

